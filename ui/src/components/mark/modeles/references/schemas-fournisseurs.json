{
  "llm": {
    "mistral": {
      "description": "Mistral AI chat and Voxtral text-to-speech.",
      "properties": {
        "provider": {
          "const": "mistral",
          "default": "mistral",
          "title": "Provider",
          "type": "string"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Api Key"
        },
        "model": {
          "allow_custom_input": true,
          "default": "mistral-medium-latest",
          "description": "Mistral chat model to use.",
          "examples": [
            "mistral-medium-latest",
            "mistral-large-latest",
            "mistral-small-latest",
            "magistral-medium-latest"
          ],
          "title": "Model",
          "type": "string"
        },
        "base_url": {
          "default": "https://api.eu.mistral.ai/v1",
          "description": "Mistral API endpoint. Defaults to the EU endpoint.",
          "mark_groupe": "technique",
          "mark_libelle": {
            "en": "Base URL",
            "fr": "Adresse du service"
          },
          "title": "Base Url",
          "type": "string"
        },
        "temperature": {
          "default": 0.1,
          "description": "How much randomness goes into each word. Low keeps answers predictable and on-script; high makes them varied and less reliable. Mistral recommends 0.0 to 0.7. Defaults to 0.1, the value that was hardcoded before this field existed.",
          "mark_groupe": "generation",
          "mark_libelle": {
            "en": "Temperature",
            "fr": "Température"
          },
          "maximum": 1.5,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fixes the draw: two identical calls give back the same conversation. A laboratory tool for comparing two settings, not a production one. Left empty, each call is drawn afresh.",
          "mark_groupe": "technique",
          "mark_libelle": {
            "en": "Seed",
            "fr": "Graine"
          },
          "title": "Seed"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Longest answer the model may produce, in tokens (a token is roughly three quarters of a word). An answer half as long comes back about twice as fast, which is heard on the phone. WARNING: this ceiling also applies to the out-of-band call that fills in the call report, so a low value can truncate it and leave fields empty. Left empty, the model stops when it has finished.",
          "mark_groupe": "generation",
          "mark_libelle": {
            "en": "Max tokens",
            "fr": "Longueur maximale d'une réponse"
          },
          "title": "Max Tokens"
        },
        "top_p": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restricts the draw to the most likely words: 0.1 keeps only the top 10% of the probability mass. Acts on the same phenomenon as temperature, so Mistral advises changing one or the other, not both. Above 0 and up to 1.",
          "mark_groupe": "generation",
          "mark_libelle": {
            "en": "Top p",
            "fr": "Échantillonnage (top p)"
          },
          "title": "Top P"
        },
        "frequency_penalty": {
          "anyOf": [
            {
              "maximum": 2.0,
              "minimum": -2.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Discourages repeating a word already used often in the answer. From -2 to 2; positive values reduce repetition.",
          "mark_groupe": "repetition",
          "mark_libelle": {
            "en": "Frequency penalty",
            "fr": "Pénalité de fréquence"
          },
          "title": "Frequency Penalty"
        },
        "presence_penalty": {
          "anyOf": [
            {
              "maximum": 2.0,
              "minimum": -2.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pushes the model towards subjects it has not brought up yet. From -2 to 2; positive values widen the range of topics.",
          "mark_groupe": "repetition",
          "mark_libelle": {
            "en": "Presence penalty",
            "fr": "Pénalité de présence"
          },
          "title": "Presence Penalty"
        }
      },
      "provider_docs_url": "https://docs.mistral.ai/",
      "required": [
        "api_key"
      ],
      "title": "Mistral",
      "type": "object"
    }
  },
  "tts": {
    "elevenlabs": {
      "properties": {
        "provider": {
          "const": "elevenlabs",
          "default": "elevenlabs",
          "title": "Provider",
          "type": "string"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Api Key"
        },
        "voice": {
          "default": "21m00Tcm4TlvDq8ikWAM",
          "description": "ElevenLabs voice ID from your Voice Library.",
          "mark_groupe": "voix",
          "mark_libelle": {
            "en": "Voice",
            "fr": "Voix"
          },
          "title": "Voice",
          "type": "string"
        },
        "speed": {
          "default": 1.0,
          "description": "Speed of the voice.",
          "mark_groupe": "voix",
          "mark_libelle": {
            "en": "Speed",
            "fr": "Vitesse"
          },
          "maximum": 2.0,
          "minimum": 0.1,
          "title": "Speed",
          "type": "number"
        },
        "model": {
          "allow_custom_input": true,
          "default": "eleven_flash_v2_5",
          "description": "ElevenLabs TTS model.",
          "examples": [
            "eleven_flash_v2_5"
          ],
          "title": "Model",
          "type": "string"
        },
        "base_url": {
          "default": "https://api.elevenlabs.io",
          "description": "ElevenLabs API base URL. Override to use a Data Residency endpoint (e.g. https://api.eu.residency.elevenlabs.io) for GDPR / HIPAA / regional compliance.",
          "mark_groupe": "technique",
          "mark_libelle": {
            "en": "Base URL",
            "fr": "Adresse du service"
          },
          "title": "Base Url",
          "type": "string"
        }
      },
      "required": [
        "api_key"
      ],
      "title": "ElevenLabs",
      "type": "object"
    }
  },
