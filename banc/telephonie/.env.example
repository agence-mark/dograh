# Valeurs du banc de téléphonie. Ce fichier est un modèle : les vraies valeurs
# vivent dans .env (jamais commité), écrit par « ./banc.sh preparer » avec des
# valeurs tirées au hasard. Elles ne protègent que des conteneurs locaux, sur un
# réseau sans accès extérieur.

BANC_ARI_UTILISATEUR=banc
BANC_ARI_MOT_DE_PASSE=a-generer
BANC_POSTGRES_MOT_DE_PASSE=a-generer
BANC_REDIS_MOT_DE_PASSE=a-generer
BANC_JWT_SECRET=a-generer

# Compte créé dans le fork du banc (premier compte de l'installation locale).
BANC_COMPTE_COURRIEL=banc@example.com
BANC_COMPTE_MOT_DE_PASSE=a-generer

# Scénario 14 : jeton du flux audio. Vides : comportement de production actuel.
BANC_WS_TOKEN_SECRET=
BANC_WS_TOKEN_ENFORCE=false

# Scénario 13 : nombre d'appels simultanés permis par organisation.
BANC_LIMITE_APPELS=10
# Clé factice remise aux faux fournisseurs du banc, qui n'en lisent aucune.
BANC_CLE_FACTICE=a-generer
